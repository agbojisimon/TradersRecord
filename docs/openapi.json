  "components": {
    "schemas": {
      "AuthResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "businessId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "role": {
            "type": "string"
          },
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BusinessSummaryResponse": {
        "type": "object",
        "properties": {
          "businessId": {
            "type": "string",
            "format": "uuid"
          },
          "businessName": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "windowStartUtc": {
            "type": "string",
            "format": "date-time"
          },
          "windowEndExclusiveUtc": {
            "type": "string",
            "format": "date-time"
          },
          "totalSalesMinor": {
            "type": "integer",
            "format": "int64"
          },
          "totalExpensesMinor": {
            "type": "integer",
            "format": "int64"
          },
          "netCashFlowMinor": {
            "type": "integer",
            "format": "int64"
          },
          "transactionCount": {
            "type": "integer",
            "format": "int32"
          },
          "weekly": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WeeklySummary"
            }
          },
          "indicator": {
            "$ref": "#/components/schemas/ConsistencyIndicator"
          }
        }
      },
      "ConsentResponse": {
        "type": "object",
        "properties": {
          "businessId": {
            "type": "string",
            "format": "uuid"
          },
          "lenderId": {
            "type": "string",
            "format": "uuid"
          },
          "isActive": {
            "type": "boolean"
          },
          "grantedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "revokedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ConsistencyIndicator": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "activeDays": {
            "type": "integer",
            "format": "int32"
          },
          "activeWeeks": {
            "type": "integer",
            "format": "int32"
          },
          "historySpanWeeks": {
            "type": "integer",
            "format": "int32"
          },
          "disclaimer": {
            "type": "string"
          },
          "guidance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ItemError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          }
        }
      },
      "SyncBatchRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncItemRequest"
            },
            "nullable": true
          }
        }
      },
      "SyncBatchResponse": {
        "type": "object",
        "properties": {
          "receivedCount": {
            "type": "integer",
            "format": "int32"
