@HostAddress = http://localhost:5080
@Token = <paste-access-token-here>
@ClientIdSale = 11111111-1111-4111-8111-111111111111
@ClientIdExpense = 22222222-2222-4222-8222-222222222222

GET {{HostAddress}}/api/health
Accept: application/json

###

GET {{HostAddress}}/openapi/v1.json
Accept: application/json

###

POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Trader",
  "email": "trader3@example.test",
  "password": "Trader3!Demo2026",
  "businessName": "Test Trader Stores"
}

###

POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "trader1@example.test",
  "password": "Trader1!Demo2026"
}

###

# Requires a Trader token. Timestamps must be in the last 365 days; update them
# if this example becomes stale.
POST {{HostAddress}}/api/transactions/sync
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "items": [
    {
      "clientId": "{{ClientIdSale}}",
      "type": "Sale",
      "amountMinor": 4500000,
      "note": "Sold rice",
      "occurredAt": "2026-11-03T09:00:00+01:00"
    },
    {
      "clientId": "{{ClientIdExpense}}",
      "type": "Expense",
      "amountMinor": 1200000,
      "note": "Stock purchase",
      "occurredAt": "2026-11-03T09:05:00+01:00"
    }
  ]
}

###

# Identical retry: both items return Duplicate and no new rows are inserted.
POST {{HostAddress}}/api/transactions/sync
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "items": [
    {
      "clientId": "{{ClientIdSale}}",
      "type": "Sale",
      "amountMinor": 4500000,
      "note": "Sold rice",
      "occurredAt": "2026-11-03T09:00:00+01:00"
    },
    {
      "clientId": "{{ClientIdExpense}}",
      "type": "Expense",
      "amountMinor": 1200000,
      "note": "Stock purchase",
      "occurredAt": "2026-11-03T09:05:00+01:00"
    }
  ]
}

###

# Changed payload for an existing clientId: item-level CLIENT_ID_CONFLICT, not 409.
POST {{HostAddress}}/api/transactions/sync
Content-Type: application/json
Authorization: Bearer {{Token}}

{
  "items": [
    {
      "clientId": "{{ClientIdSale}}",
      "type": "Sale",
      "amountMinor": 9999999,
      "note": "Changed amount",
      "occurredAt": "2026-11-03T09:00:00+01:00"
    }
  ]
}

###

# Requires a Trader token. Returns eight Lagos weeks and the consistency indicator.
GET {{HostAddress}}/api/businesses/me/summary
Accept: application/json
Authorization: Bearer {{Token}}

###

GET {{HostAddress}}/api/health
Accept: application/json
Authorization: Bearer {{Token}}

###
